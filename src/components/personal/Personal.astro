---
import { type Lang, profile, projects, experience, live } from '../../data/resume';
import { p, signatures, cardVisual, cardOrder, tech } from '../../data/personal';
import demo from '../../data/demo.json';
import { url, dirOf, other } from '../../lib';
import Console from './Console.astro';
import '../../styles/personal.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = lang;
const ar = L === 'ar';
const site = Astro.site!;
const canonical = new URL(url(`/personal/${lang}/`), site).href;
const nf = (n: number) => n.toLocaleString(ar ? 'ar-EG' : 'en-US');

const numbers = [
  { value: live.subscribers, label: p.numbers.subscribers[L], live: 'subscribers' },
  { value: live.npmMonthly, label: p.numbers.npm[L], live: 'npm' },
  { value: 4, label: p.numbers.mcp[L] },
  { value: 18, label: p.numbers.sources[L] },
];
const groups = ['all', 'ai', 'bots', 'web'] as const;
const cards = cardOrder.map((id) => projects.find((x) => x.id === id)!);
const liveIds = new Set(['paper-search', 'storyset']);
const shotAlt = (title: string) => (ar ? `لقطة شاشة من ${title}` : `Screenshot of ${title}`);

const years = [ar ? '2023 - الآن' : '2023 - now', '2022 - 2023', ar ? '2020 - الآن' : '2020 - now', ar ? '2020 - الآن' : '2020 - now', '2021', '2018 - 2019'];
const pathItems = experience.map((j, i) => ({ years: years[i], role: j.role[L], org: j.org[L], line: j.bullets[L][0] }));
const nameWords = profile.name[L].split(' ');
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{p.title[L]}</title>
  <meta name="description" content={p.description[L]} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ar" href={new URL(url('/personal/ar/'), site).href} />
  <link rel="alternate" hreflang="en" href={new URL(url('/personal/en/'), site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={p.title[L]} />
  <meta property="og:description" content={p.description[L]} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(url(`/og/personal-${lang}.png`), site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preconnect" href="https://paper-search-mcp.engdawood.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@dawod/thmanyah-font-web/index.css" />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      var t = null;
      try { t = localStorage.getItem('dr-theme'); } catch (e) {}
      d.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();
  </script>
</head>
<body class="per">
  <a class="skip" href="#work">{p.nav.work[L]}</a>

  <header class="nav">
    <a class="brand" href={url(`/personal/${lang}/`)}>
      <span class="mark" aria-hidden="true">{ar ? 'د' : 'D'}</span>
      <span class="brand-name">{profile.name[L]}</span>
    </a>
    <nav class="nav-links" aria-label={ar ? 'الأقسام' : 'Sections'}>
      <a href="#work">{p.nav.work[L]}</a>
      <a href="#path">{p.nav.path[L]}</a>
      <a href="#contact">{p.nav.contact[L]}</a>
    </nav>
    <div class="nav-tools">
      <a class="chip" href={url(`/personal/${other(lang)}/`)} hreflang={other(lang)} lang={other(lang)}>{p.nav.other[L]}</a>
      <button class="chip" type="button" data-theme-toggle data-light={p.nav.day[L]} data-dark={p.nav.night[L]} aria-label={ar ? 'تبديل الوضع الفاتح والداكن' : 'Toggle light and dark mode'}>
        <span class="tdot" aria-hidden="true"></span><span class="theme-label"></span>
      </button>
      <a class="chip solid" href={url(`/${lang}/`)}>{p.nav.cv[L]}</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-text">
        <p class="kicker reveal">{p.hero.kicker[L]}</p>
        <h1 class="name reveal" style="--d:60ms">
          <span class="nl">{nameWords.slice(0, 2).join(' ')}</span>
          {nameWords.length > 2 && <span class="nl">{nameWords.slice(2).join(' ')}</span>}
        </h1>
        <p class="line reveal" style="--d:120ms">{p.hero.line[L]}</p>
        <div class="ctas reveal" style="--d:180ms">
          <a class="btn primary" href="#work">{p.hero.cta[L]}</a>
          <a class="btn" href={url(`/${lang}/`)}>{p.nav.cv[L]}</a>
        </div>
      </div>
      <div class="hero-console reveal" style="--d:140ms">
        <Console lang={lang} />
      </div>
    </section>

    <section class="numbers" aria-label={p.numbers.live[L]}>
      <p class="live-note"><span class="pulse" aria-hidden="true"></span>{p.numbers.live[L]}</p>
      <ul>
        {numbers.map((n, i) => (
          <li class="reveal" style={`--d:${i * 80}ms`}>
            <strong class="num" data-count={n.value} data-live={n.live} data-locale={ar ? 'ar-EG' : 'en-US'}>{nf(n.value)}</strong>
            <span>{n.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="work" class="work">
      <header class="sec-head">
        <h2 class="reveal">{p.work.title[L]}</h2>
        <p class="sub reveal" style="--d:60ms">{p.work.sub[L]}</p>
        <div class="filters reveal" style="--d:120ms" role="group" aria-label={ar ? 'تصفية المشاريع' : 'Filter projects'}>
          {groups.map((g) => (
            <button type="button" class:list={['filter', g === 'all' && 'on']} data-filter={g} aria-pressed={g === 'all' ? 'true' : 'false'}>
              {p.work.filters[g][L]}
              <span class="count">{g === 'all' ? projects.length : projects.filter((x) => x.group === g).length}</span>
            </button>
          ))}
        </div>
      </header>

      <ul class="cards">
        {cards.map((proj) => {
          const vis = cardVisual[proj.id];
          return (
            <li class:list={['card', 'reveal', vis ? 'wide' : 'normal', `g-${proj.group}`]} data-group={proj.group} data-id={proj.id}>
              <button type="button" class="card-btn" data-open={proj.id} aria-haspopup="dialog">
                {vis && (
                  <span class:list={['vis', `vis-${vis}`]} data-vis>
                    {vis === 'papers' && (
                      <span class="vis-papers" dir="ltr">
                        {demo.papers.papers.slice(0, 3).map((x) => <span class="vp"><b>{x.title}</b><i>{x.source} · {x.year}</i></span>)}
                      </span>
                    )}
                    {vis === 'storyset' && (
                      <span class="vis-story">
                        {demo.storyset.results.slice(0, 3).map((x) => <img src={x.preview_url} alt="" loading="lazy" width="200" height="150" />)}
                      </span>
                    )}
                    {vis === 'subscribers' && (
                      <span class="vis-num">
                        <b data-live="subscribers" data-count={live.subscribers} data-locale={ar ? 'ar-EG' : 'en-US'}>{nf(live.subscribers)}</b>
                        <i>{p.work.subscribers[L]} · ‎@hr_yemen</i>
                      </span>
                    )}
                    {vis === 'shot' && <img class="shot" src={url(`/shots/${proj.id}.webp`)} alt={shotAlt(proj.title[L])} loading="lazy" width="960" height="600" />}
                  </span>
                )}
                <span class="card-body">
                  <span class="card-top">
                    <span class="card-group">{p.work.filters[proj.group][L]}</span>
                    {liveIds.has(proj.id) && <span class="badge live"><span class="pulse" aria-hidden="true"></span>{p.work.live[L]}</span>}
                    {proj.client && <span class="badge">{p.work.client[L]}</span>}
                  </span>
                  <span class="card-title">{proj.title[L]}</span>
                  <code class="card-sig" dir="ltr">{signatures[proj.id]}</code>
                  <span class="card-hook">{proj.hook[L]}</span>
                </span>
              </button>
              <template data-tpl={proj.id}>
                <p class="d-group">{p.work.filters[proj.group][L]}{proj.client && ` · ${p.work.client[L]}`}</p>
                <h3 class="d-title">{proj.title[L]}</h3>
                <code class="card-sig" dir="ltr">{signatures[proj.id]}</code>
                <p class="d-hook">{proj.hook[L]}</p>
                <ul class="d-points">{proj.bullets[L].map((b) => <li>{b}</li>)}</ul>
                <p class="d-stack">{proj.stack.map((s) => <span>{s}</span>)}</p>
                <p class="d-links">{proj.links.map((l) => <a href={l.href} target="_blank" rel="noopener" dir="ltr">{l.label} <span aria-hidden="true">↗</span></a>)}</p>
              </template>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="path" class="path">
      <h2 class="path-title reveal">{p.path.title[L]}</h2>
      <ol class="path-list">
        {pathItems.map((it, i) => (
          <li class="reveal" style={`--d:${i * 50}ms`}>
            <span class="yrs">{it.years}</span>
            <div>
              <h3>{it.role} <span class="org">{it.org}</span></h3>
              <p>{it.line}</p>
            </div>
          </li>
        ))}
        <li class="reveal edu">
          <span class="yrs">2016 - 2020</span>
          <div><h3>{p.path.education[L]}</h3></div>
        </li>
      </ol>
    </section>

    <section class="tech">
      <h2 class="reveal">{p.tech.title[L]}</h2>
      <div class="tech-grid">
        {tech.map((g, i) => (
          <div class="tech-group reveal" style={`--d:${i * 60}ms`}>
            <h3>{g.label[L]}</h3>
            <ul dir="ltr">{g.items.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section id="contact" class="contact">
      <h2 class="reveal">{p.contact.title[L]}</h2>
      <p class="sub reveal" style="--d:60ms">{p.contact.sub[L]}</p>
      <div class="contact-row reveal" style="--d:120ms">
        <a class="btn primary big" href={`mailto:${profile.email}`}>{p.contact.email[L]}</a>
        <button class="btn big" type="button" data-copy={profile.email} data-done={p.contact.copied[L]}>{p.contact.copy[L]}</button>
      </div>
      <p class="mail" dir="ltr">{profile.email}</p>
      <ul class="socials reveal" style="--d:180ms">
        {profile.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener" dir="ltr">{l.label}</a></li>)}
        <li><a href={url('/ar/')}>{p.contact.cvAr[L]}</a></li>
        <li><a href={url('/en/')}>{p.contact.cvEn[L]}</a></li>
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p>{p.footer.made[L]}</p>
    <p><a href="https://github.com/EngDawood/Dawood-resume" target="_blank" rel="noopener">{p.footer.source[L]}</a> · © 2026 {profile.name[L]}</p>
  </footer>

  <dialog class="sheet" id="project-dialog" aria-labelledby="dlg-title">
    <div class="sheet-vis"></div>
    <div class="sheet-body"></div>
    <button class="sheet-close" type="button" data-close aria-label={p.work.close[L]}>×</button>
  </dialog>

  <div class="toast" role="status" aria-live="polite"></div>

  <script>
    import { init } from '../../scripts/personal';
    init();
  </script>
</body>
</html>
